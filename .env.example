# 1. Core AI Inference Gateway (Required for dynamic generative LLM responses)
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 2. ElevenLabs Speech Synthesis (Natural Conversational Voice)
# Obtain from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# Locked Voice ID: Alexandra — Conversational and Natural (kdmDKE6EkgrWrrykO9Qt)
ELEVENLABS_VOICE_ID="kdmDKE6EkgrWrrykO9Qt"
# Locked Model ID: eleven_multilingual_v2
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# 3. LiveAvatar Real-Time Video Streaming (Optional — WebRTC Live Video)
# In the ElevenLabs Live Avatar architecture:
# https://elevenlabs.io/docs/eleven-agents/guides/integrations/live-avatar
# HeyGen's LiveAvatar platform provides real-time WebRTC video streaming.
# Obtain from: https://liveavatar.com or HeyGen developer settings
LIVEAVATAR_API_KEY=""
LIVEAVATAR_API_URL="https://api.liveavatar.com/v1/sessions"
